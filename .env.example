PORT=5000
MONGO_URI=mongodb+srv://ashwiniy_db_user:ashwiniy@cluster0.dvid7du.mongodb.net/codegrade

JWT_SECRET=change-me-to-a-long-random-string
# The account that registers with this email becomes the Admin
ADMIN_EMAIL=admin@example.com
FRONTEND_ORIGIN=http://localhost:5173
# Gemini has a free API quota; use it for deployed environments.
GEMINI_API_KEY=your-google-ai-studio-key
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.6-flash
# Groq (use AI_PROVIDER=groq to route evaluations through Groq)
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-20b
ANTHROPIC_API_KEY=sk-ant-your-key
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
AI_PROVIDER=groq
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
AI_MAX_CONCURRENT=2
AI_TIMEOUT_MS=180000
# Isolated Docker execution service (start with: docker compose up --build execution-service)
EXECUTION_SERVICE_URL=http://localhost:4001/execute
EXECUTION_SERVICE_TOKEN=
MONGO_MAX_POOL_SIZE=100
MONGO_MIN_POOL_SIZE=10

# Cloudinary — file storage for starter & submission ZIPs (replaces MongoDB GridFS)
# Sign up free at https://cloudinary.com → Dashboard → Copy these three values
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
